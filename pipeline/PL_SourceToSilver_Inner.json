{
	"name": "PL_SourceToSilver_Inner",
	"properties": {
		"activities": [
			{
				"name": "Read Table Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set variable1 to fetch current TS",
				"description": "this is being used for fetch current timestamp",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "TimeStamp",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "landing to bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "check source system",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-adb-repo/landingToBrone",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Read Table Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read Table Details').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timeStamp": {
							"value": "@variables('TimeStamp')",
							"type": "Expression"
						},
						"source_file_format": {
							"value": "@coalesce(activity('Read Table Details').output.firstRow.source_file_format,'')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze to silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "landing to bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-adb-repo/bronzeToSilver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Read Table Details').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timeStamp": {
							"value": "@variables('TimeStamp')",
							"type": "Expression"
						},
						"merge_key": {
							"value": "@coalesce(\nactivity('Read Table Details').output.firstRow.merge_keys,''\n)",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read Table Details').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "update record count",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze to silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log\nset status='SUCCESS', end_time=sysutcdatetime(),records_written=@{activity('bronze to silver').output.runOutput}\nwhere adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{pipeline().parameters.table_id};",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "check load type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read Table Details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set variable1 to fetch current TS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Table Details').output.firstRow.load_type,'FULL' ))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Read watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select watermark_value from ctrl.watermark where table_id=@{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "store watermark",
							"description": "its getting used to check whether read watermark is getting executed or not - time 2hr 33min",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Read watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark value",
								"value": {
									"value": "@activity('Read watermark').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "check load type and update the watermark",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "bronze to silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Table Details').output.firstRow.load_type,'FULL' ))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "update watermark",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase1",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.watermark\nset watermark_value=SYSUTCDATETIME()\nwhere table_id=@{pipeline().parameters.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "check source system",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "check load type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Read Table Details').output.firstRow.source_system",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "neon_postgres",
							"activities": [
								{
									"name": "Postgres_source to landing ingestion",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "select * from PUBLIC.@{activity('Read Table Details').output.firstRow.source_table_name}\n@{\n    if(equals(activity('Read Table Details').output.firstRow.load_type,'FULL' )\n    ,''\n    , concat(\n        'where ',activity('Read Table Details').output.firstRow.watermark_column,'>','''',variables('watermark value'),''''\n            )\n      )\n}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_PostgreSqlTable1",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "DS_ADLS_Parquet1",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(\n    activity('Read Table Details').output.firstRow.source_system,\n    '/',\n    activity('Read Table Details').output.firstRow.source_table_name,\n    '/',\n    variables('TimeStamp')\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "adls_csv",
							"activities": [
								{
									"name": "ADLS_Copy data",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"modifiedDatetimeStart": {
													"value": "@variables('watermark value')",
													"type": "Expression"
												},
												"deleteFilesAfterCompletion": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "DS_CSV_Binary",
											"type": "DatasetReference",
											"parameters": {
												"folder": {
													"value": "@activity('Read Table Details').output.firstRow.source_path",
													"type": "Expression"
												},
												"container": "source"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_CSV_Binary",
											"type": "DatasetReference",
											"parameters": {
												"folder": {
													"value": "@concat(\n    activity('Read Table Details').output.firstRow.source_system,\n    '/',\n    activity('Read Table Details').output.firstRow.source_table_name,\n    '/',\n    variables('TimeStamp')\n)",
													"type": "Expression"
												},
												"container": "landing"
											}
										}
									]
								}
							]
						}
					]
				}
			},
			{
				"name": "landing to bronze_copy1",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/caresync-repo/caresync-adb-repo/landingToBrone",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Read Table Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read Table Details').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timeStamp": {
							"value": "@variables('TimeStamp')",
							"type": "Expression"
						},
						"source_file_format": {
							"value": "@coalesce(activity('Read Table Details').output.firstRow.source_file_format,'')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "update record count_copy1",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log\nset status='SUCCESS', end_time=sysutcdatetime(),records_written=@{activity('bronze to silver').output.runOutput}\nwhere adf_run_id='@{pipeline().parameters.adf_run_id}' and table_id=@{pipeline().parameters.table_id};",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"TimeStamp": {
				"type": "String"
			},
			"watermark value": {
				"type": "String"
			}
		},
		"annotations": []
	}
}